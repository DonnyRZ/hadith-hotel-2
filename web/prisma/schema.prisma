// HADITH Hotel 2 — Prisma schema
// Ready for later CMS/API use; pages start with static structure + media placeholders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id        String   @id @default(cuid())
  name      String   @default("HADITH Hotel")
  tagline   String?
  location  String   @default("Samarkand, Uzbekistan")
  complex   String   @default("Complex of Imam Al Bukhari")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInfo {
  id        String   @id @default(cuid())
  label     String
  value     String
  type      String // email | phone | address
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteVisitor {
  id           String    @id @default(cuid())
  visitorHash  String    @unique
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime
  /// Sightings for this browser. Increments on each full page load after the cookie exists.
  viewCount    Int       @default(1)
  city         String?
  region       String?
  countryCode  String?
  geoCheckedAt DateTime?

  @@index([lastSeenAt])
  @@index([city])
}

/// One row per counted site visit. Geography ranks these, not the sticky
/// first-seen city on WebsiteVisitor.
model WebsiteVisitorEvent {
  id          String   @id @default(cuid())
  visitorHash String
  seenAt      DateTime @default(now())
  city        String?
  region      String?
  countryCode String?

  @@index([visitorHash])
  @@index([seenAt])
  @@index([city])
  @@index([region])
  @@index([countryCode])
}

model ProfileDownload {
  id                String    @id @default(cuid())
  visitorHash       String
  documentVersion   String    @default("2026-07")
  firstDownloadedAt DateTime  @default(now())
  lastDownloadedAt  DateTime
  /// Tracked clicks for this browser + document version. Increments on each tracked click.
  downloadCount     Int       @default(1)
  city              String?
  region            String?
  countryCode       String?
  geoCheckedAt      DateTime?

  @@index([city])
  @@index([region])
  @@index([countryCode])
  @@unique([visitorHash, documentVersion])
}

/// One row per counted profile-download click. Geography ranks these, not the
/// first-seen city on ProfileDownload.
model ProfileDownloadEvent {
  id               String   @id @default(cuid())
  visitorHash      String
  documentVersion  String
  downloadedAt     DateTime @default(now())
  city             String?
  region           String?
  countryCode      String?

  @@index([visitorHash])
  @@index([documentVersion])
  @@index([downloadedAt])
  @@index([city])
  @@index([region])
  @@index([countryCode])
}

model GuestRegistration {
  id              String    @id @default(cuid())
  name            String
  surname         String
  position        String
  phone           String?
  email           String?
  arrivalDate     DateTime
  hasCompanions   Boolean   @default(false)
  /// Guests travelling with the registrant, not counting the registrant.
  companionsCount Int       @default(0)
  /// companionsCount + 1 (the registrant).
  totalGuests     Int       @default(1)
  locale          String    @default("en")
  syncedToSheetAt DateTime?
  syncError       String?
  createdAt       DateTime  @default(now())

  @@index([createdAt])
}
